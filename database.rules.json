{
  "rules": {
    "tournois": {
      "$id": {
        ".read": true,
        "donnees": {
          ".write": "auth != null && root.child('tournois').child($id).child('admins').child(auth.uid).val() === true"
        },
        "admins": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.val() === true && root.child('cles').child($id).exists() && newData.parent().parent().parent().parent().child('preuves').child($id).child($uid).val() === root.child('cles').child($id).val()"
          }
        },
        "propositions": {
          ".write": "auth != null && root.child('tournois').child($id).child('admins').child(auth.uid).val() === true",
          "$match": {
            "$equipe": {
              ".write": "auth != null",
              ".validate": "newData.hasChildren(['sets', 'date', 'uid']) && newData.child('uid').val() === auth.uid"
            }
          }
        },
        "miniatures": {
          ".write": "auth != null && root.child('tournois').child($id).child('admins').child(auth.uid).val() === true",
          "$photo": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('tournois').child($id).child('donnees').exists() && root.child('tournois').child($id).child('donnees').child('reglages').child('photos').val() !== false) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['image', 'date', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('image').isString() && newData.child('image').val().length < 60000 && newData.child('image').val().beginsWith('data:image/jpeg;base64,')"
          }
        },
        "photos": {
          ".write": "auth != null && root.child('tournois').child($id).child('admins').child(auth.uid).val() === true",
          "$photo": {
            ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('tournois').child($id).child('donnees').exists() && root.child('tournois').child($id).child('donnees').child('reglages').child('photos').val() !== false) || (data.exists() && !newData.exists() && data.child('uid').val() === auth.uid))",
            ".validate": "newData.hasChildren(['image', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('image').isString() && newData.child('image').val().length < 700000 && newData.child('image').val().beginsWith('data:image/jpeg;base64,')"
          }
        },
        "equipesPhotos": {
          ".write": "auth != null && root.child('tournois').child($id).child('admins').child(auth.uid).val() === true",
          "$equipe": {
            ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || root.child('tournois').child($id).child('donnees').exists() && root.child('tournois').child($id).child('donnees').child('reglages').child('photos').val() !== false)",
            ".validate": "newData.hasChildren(['image', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('image').isString() && newData.child('image').val().length < 80000 && newData.child('image').val().beginsWith('data:image/jpeg;base64,')"
          }
        }
      }
    },
    "cles": {
      "$id": {
        ".write": "auth != null && !data.exists() && newData.isString() && newData.val().length >= 20"
      }
    },
    "preuves": {
      "$id": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
